<?xml version="1.0" encoding="utf-8"?>
<!-- Sideways (the car mount): artwork on the left, controls on the right. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/np_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurface" android:paddingHorizontal="24dp">

    <com.google.android.material.button.MaterialButton android:id="@+id/np_close" style="?attr/materialIconButtonStyle"
        android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Close"
        app:icon="@drawable/ic_player_collapse" app:iconTint="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="-12dp"/>

    <com.google.android.material.card.MaterialCardView android:id="@+id/np_art_card" style="?attr/materialCardViewFilledStyle"
        android:layout_width="0dp" android:layout_height="0dp" android:layout_marginVertical="12dp"
        app:cardCornerRadius="28dp" app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/np_close" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView android:id="@+id/np_art" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:importantForAccessibility="no"/>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="32dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/np_art_card" app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <include android:id="@+id/np_controls" layout="@layout/now_playing_controls"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical"/>
        </FrameLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
