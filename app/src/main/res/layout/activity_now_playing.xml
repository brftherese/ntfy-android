<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/np_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurface" android:paddingHorizontal="24dp">

    <com.google.android.material.button.MaterialButton android:id="@+id/np_close" style="?attr/materialIconButtonStyle"
        android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Close"
        app:icon="@drawable/ic_player_collapse" app:iconTint="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="-12dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Now playing"
        android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toTopOf="@id/np_close" app:layout_constraintBottom_toBottomOf="@id/np_close"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.card.MaterialCardView android:id="@+id/np_art_card" style="?attr/materialCardViewFilledStyle"
        android:layout_width="0dp" android:layout_height="0dp" android:layout_marginVertical="20dp"
        app:cardCornerRadius="28dp" app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:layout_constraintDimensionRatio="1:1" app:layout_constraintWidth_max="420dp"
        app:layout_constraintTop_toBottomOf="@id/np_close" app:layout_constraintBottom_toTopOf="@id/np_controls"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:id="@+id/np_art" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:importantForAccessibility="no"/>
    </com.google.android.material.card.MaterialCardView>

    <include android:id="@+id/np_controls" layout="@layout/now_playing_controls"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
